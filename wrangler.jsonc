{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sinapse",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "upload_source_maps": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/ranking", "/ranking/"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "sinapse",
    // Placeholder para desenvolvimento local. Para publicar, copie o ID de `wrangler d1 create sinapse`.
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{ "name": "IP_LIMIT", "namespace_id": "1001", "simple": { "limit": 6000, "period": 60 } }]
}
